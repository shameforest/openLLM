{
  "$schema": "https://opencode.ai/config.json",
  "_note": "OpenDante default OpenCode config, installed to ~/.config/opencode/ by scripts/install.ps1, which validates it with `opencode models` before keeping it. Pinned to OpenCode 1.x (OpenCode 2 changes this schema and the server API). Only real OpenCode keys inside blocks: a comment key inside `permission` is read as a rule and makes the whole config invalid. limit.context/output MUST be set (they default to 0); temperature must be true for agents to set it. Default model = the uncensored Qwen3.8 27B (list: config/models.json). task=deny: subagents of a local 27B model gave no benefit on one GPU and failed with Ollama 'no user query found in messages'. Bash rules: last match wins, so the ask/deny lines come after the allow lines. Do not set external_directory here and do not set a plain edit:deny for the plan agent: both would override OpenCode's built-in exception that lets plan mode write its plan to ~/.local/share/opencode/plans (measured 2026-10-15 via GET /agent). Variant ohne-denken (OD-16): reasoningEffort reaches Ollama as reasoning_effort none and switches Qwen3.8's thinking off; low and think:false had no effect (measured 2026-10-15).",
  "model": "ollama/orcarouter/Qwen3.8-27B-Uncensored:q4_K_M",
  "autoupdate": false,
  "share": "disabled",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": { "baseURL": "http://localhost:11434/v1" },
      "models": {
        "orcarouter/Qwen3.8-27B-Uncensored:q4_K_M": {
          "name": "Qwen3.8 27B Uncensored (local)",
          "temperature": true,
          "limit": { "context": 65536, "output": 8192 },
          "variants": { "ohne-denken": { "reasoningEffort": "none" } }
        },
        "qwen3.8:27b": {
          "name": "Qwen3.8 27B (local)",
          "temperature": true,
          "limit": { "context": 65536, "output": 8192 },
          "variants": { "ohne-denken": { "reasoningEffort": "none" } }
        },
        "huihui_ai/Qwen3.8-abliterated:27b-q4_K_M": {
          "name": "Qwen3.8 27B Abliterated huihui (local)",
          "temperature": true,
          "limit": { "context": 65536, "output": 8192 },
          "variants": { "ohne-denken": { "reasoningEffort": "none" } }
        }
      }
    }
  },
  "mcp": {
    "playwright": { "type": "local", "command": ["npx", "@playwright/mcp@latest"], "enabled": false }
  },
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "task": "deny",
    "bash": {
      "*": "ask",
      "ls*": "allow", "dir*": "allow", "cat *": "allow", "type *": "allow", "grep *": "allow", "rg *": "allow", "find *": "allow", "echo *": "allow", "tree*": "allow", "pwd*": "allow", "head *": "allow", "tail *": "allow", "which *": "allow", "where *": "allow",
      "Get-ChildItem*": "allow", "Get-Content*": "allow", "Test-Path*": "allow", "Select-String*": "allow", "Select-Object*": "allow", "Where-Object*": "allow", "ForEach-Object*": "allow", "Measure-Object*": "allow", "Sort-Object*": "allow", "Get-Command*": "allow", "Get-Location*": "allow", "Resolve-Path*": "allow", "Out-String*": "allow", "Format-Table*": "allow", "Format-List*": "allow", "Write-Output*": "allow", "Write-Host*": "allow",
      "mkdir *": "allow", "New-Item*": "allow", "md *": "allow",
      "git status": "allow", "git diff*": "allow", "git log*": "allow", "git show*": "allow", "git add*": "allow", "git commit*": "allow", "git branch*": "allow", "git checkout -b*": "allow", "git stash*": "allow", "git restore --staged*": "allow",
      "npm *": "allow", "npx *": "allow", "node *": "allow", "pnpm *": "allow", "yarn *": "allow", "python *": "allow", "python3 *": "allow", "py *": "allow", "pytest*": "allow", "pip *": "allow", "uv *": "allow", "cargo *": "allow", "go *": "allow", "dotnet *": "allow", "ollama list*": "allow", "ollama show*": "allow",
      "python -c*": "ask", "python3 -c*": "ask", "py -c*": "ask", "node -e*": "ask", "node --eval*": "ask", "node -p*": "ask", "powershell*": "ask", "pwsh*": "ask", "cmd /c*": "ask", "Invoke-Expression*": "ask", "iex *": "ask",
      "git push*": "ask", "git reset --hard*": "ask", "git clean*": "ask", "git checkout -- *": "ask", "git restore *": "ask",
      "rm *": "deny", "del *": "deny", "erase *": "deny", "ri *": "deny", "rmdir *": "deny", "rd *": "deny", "Remove-Item*": "deny", "Clear-Content*": "deny", "format *": "deny", "mkfs*": "deny", "Stop-Computer*": "deny", "Restart-Computer*": "deny", "shutdown*": "deny"
    }
  },
  "agent": {
    "plan": {
      "permission": {
        "edit": { "*": "deny", "*opencode\\plans\\*.md": "allow", "*opencode/plans/*.md": "allow" },
        "bash": { "*": "ask", "git diff*": "allow", "git log*": "allow", "git status": "allow", "grep *": "allow", "rg *": "allow", "cat *": "allow", "ls*": "allow", "dir*": "allow", "Get-ChildItem*": "allow", "Get-Content*": "allow" }
      }
    }
  }
}
